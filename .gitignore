# ── Raw CMS source data (public; see README "Data Sources") ────────────
# ~4.3 GB of CMS / NBER public-use files. Not tracked in git.
# Download and place them per the README to rebuild from scratch.
/raw/

# ── Derived data ───────────────────────────────────────────────────────
# Large intermediate tables are regenerated by run_data_pipeline() and are
# distributed as derived_data.zip with each GitHub data release (unzip at the
# repo root to restore them). Only the analysis-ready county panel is
# tracked uncompressed.
/trunk/derived/*
!/trunk/derived/county_panel.csv
/trunk/raw/
/derived_data.zip

# ── R / RStudio ────────────────────────────────────────────────────────
.Rproj.user/
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata

# ── OS / editor cruft ──────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
